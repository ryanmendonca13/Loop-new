# ---------------------------------------------------------------------------
# Loop Athlete environment template. Copy to .env.local (dev), .env.staging or
# .env.production as appropriate. NEVER commit real values.
# Browser-exposed variables are prefixed VITE_ and must be safe to publish.
# ---------------------------------------------------------------------------

# Data adapter: "demo" (synthetic, in-browser, no network effects) or "supabase".
# There is no default; the app refuses to start without an explicit choice.
VITE_APP_MODE=demo
# development | staging | production. Demo mode is refused when production.
VITE_DEPLOY_ENV=development

# Supabase (browser): ONLY the publishable/anon key. Never the service role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Feature flags (P1, default off). Production gates stay closed until approved.
VITE_FLAG_TEAM_TOOLS=false
VITE_FLAG_DIRECTOR_VIEW=false
VITE_FLAG_VOICE=false
VITE_FLAG_BILLING=false

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY (Supabase Edge Function secrets: `supabase secrets set ...`).
# These must never be prefixed VITE_ and never reach the browser bundle.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVER_ONLY
APP_BASE_URL=http://localhost:5173

# AI adapter: "mock" until the owner approves a provider configuration.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=REPLACE_ME_SERVER_ONLY
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=800
AI_DAILY_BUDGET_CALLS=200
# AI action recommendations are OFF until the owner decides.
AI_ACTION_RECOMMENDATIONS=false

# Notifications: "mock" records jobs without sending. "resend"/"postmark" etc. only after approval.
NOTIFY_EMAIL_PROVIDER=mock
NOTIFY_EMAIL_API_KEY=REPLACE_ME_SERVER_ONLY
NOTIFY_FROM_ADDRESS=no-reply@example.invalid

# SMS (Twilio) is a later, DISABLED feature. Leave false.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=REPLACE_ME_SERVER_ONLY
TWILIO_AUTH_TOKEN=REPLACE_ME_SERVER_ONLY

# Stripe: TEST MODE ONLY and off by default. No live price IDs until terms are approved.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_test_REPLACE_ME_SERVER_ONLY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME_SERVER_ONLY
STRIPE_PRICE_ID_FAMILY=

# Voice transcription adapter stays off until processor/privacy/retention review.
TRANSCRIPTION_PROVIDER=off

# Local integration tests (scripts/local-db.sh)
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/loop_test
